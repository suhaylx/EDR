# Managed by TuranSec linux-service. Local edits require explicit re-registration.
[Unit]
Description=TuranSec authenticated EDR candidate service
After=network.target postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
DynamicUser=yes
User=turansec-edrd
RuntimeDirectory=turansec-edrd
RuntimeDirectoryMode=0700
UMask=0077
@@CREDENTIALS@@
ExecStart=/usr/bin/python3 -I -B @@PREFIX@@/current/scripts/release/systemd_launcher.py server --prefix @@PREFIX@@
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
TasksMax=128
MemoryMax=512M
LimitNOFILE=4096
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
